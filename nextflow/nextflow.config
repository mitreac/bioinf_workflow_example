// Settings for the Nextflow workflow. Nextflow reads this file
// automatically because it is in the same folder as main.nf.
//
// Any param can be changed on the command line, for example:
//     nextflow run nextflow/main.nf --min_quality 30

params {
    // projectDir is the folder of main.nf. Paths based on it work no matter
    // which folder the workflow is started from.
    reads       = "${projectDir}/../data/samples/*.fastq"
    scripts     = "${projectDir}/../scripts"

    // A relative path is relative to the folder where nextflow is started,
    // here the repository folder, next to results/snakemake.
    outdir      = "results/nextflow"

    // Reads with an average quality below this value are removed.
    // 20 is 1 error in 100 letters, 30 is 1 error in 1000.
    // With 30, sample C loses all its reads.
    min_quality = 20
}

// Other settings that usually go in this file (not needed for this example):
//
// process.executor = 'slurm'          run each task as a cluster job
// process.container = 'image:tag'     run each task in a container
// docker.enabled = true
// profiles { cluster { ... } }        groups of settings, chosen with -profile
